{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make packs)",
      "Bash(make fmt)",
      "Bash(make eval-quick)",
      "Bash(make corpus-check)",
      "Bash(python -m packs.build)",
      "Bash(python -m packs.build --check)",
      "Bash(python -m corpus.validate:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(graphify query:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify path:*)",
      "Bash(graphify update .)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./corpus/holdout/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
