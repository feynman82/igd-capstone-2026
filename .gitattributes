# graph.json is regenerated on every commit by the graphify post-commit hook, so two
# people committing in the same week will always conflict in it. graphify ships a
# union merge driver for exactly this. Each clone must register the driver once:
#
#     make graph-setup        (or: git config merge.graphify.driver "graphify merge-driver %O %A %B")
#
# Without that config git falls back to a normal conflict, which is recoverable but
# noisy — see docs/GRAPHIFY.md.
graphify-out/graph.json            merge=graphify -diff linguist-generated
graphify-out/.graphify_labels.json merge=union    -diff linguist-generated
graphify-out/.graphify_analysis.json              -diff linguist-generated
graphify-out/GRAPH_REPORT.md                      -diff linguist-generated

# Generated — keep them out of diffs and out of language statistics.
core/document_schemas.py           -diff linguist-generated
corpus/register/core_columns.csv    -diff linguist-generated
docs/field-dictionary.md           -diff linguist-generated
team/*/tasks.md                    -diff linguist-generated

# Binary files, so git never tries to diff or merge them.
*.png  binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip  binary

# Grounding text is hashed to decide whether a source changed (core/grounding/corpus.py). A checkout
# that turned LF into CRLF would look like new text and re-stage every value for review.
packs/*/grounding/**/*.md          text eol=lf
*.jpg  binary
*.pdf  binary
