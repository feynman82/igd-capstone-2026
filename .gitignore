.env
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
node_modules/
web/.next/

# inbox/ IS committed, so the team shares the same drop of synthetic specimens (PDFs, ID-card
# and certificate images). Like corpus/batches/, everything in it is invented canon and carries
# a SYNTHETIC marking. A real document never goes here, nor anywhere in this repository: the
# holdout lives in ~/holdout on the integration machine (docs/governance/consent-and-redaction.md §6).

# corpus/batches/ IS committed. Synthetic batches travel through git so Lane E can hand a
# batch over by pushing it, rather than by a USB stick at the weekly session. Everything in
# it is generated from an invented canon and carries a SYNTHETIC DOCUMENT footer.
#
# The holdout is 40 *real* documents from team members, redacted under the consent protocol in
# docs/governance/. It lives OUTSIDE the repository, in ~/holdout (eval/holdout.py refuses a
# folder inside it). corpus/holdout/ stays ignored as a second lock. Committing one is not
# recoverable by deleting it — git keeps it. See NOTICE.md.
corpus/holdout/

# temp/ is a personal scratch folder for documents on their way somewhere else. Real documents
# were committed from it once (2026-10-19), so it is never tracked.
temp/

# Celery beat's record of when it last ran each sweep. Local state, not a decision.
var/

# Graphify — only the graph and the report are committed, and only by the
# integration lead at the weekly session. See docs/GRAPHIFY.md.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_analysis.json
.graphify_python

# Word lock and crash artefacts
~$*
~WRL*.tmp

# Superseded drop folder. The canonical copies live in docs/artefacts/:
#   doc/PARROT_Revised_Proposal.docx -> docs/artefacts/PARROT_Revised_Proposal_v3.docx
#   doc/PARROT_Proposal_Deck.pptx    -> docs/artefacts/PARROT_Proposal_Deck.pptx
#   doc/PARROT_diagrams.zip          -> docs/artefacts/diagrams/*.png
/doc/
.playwright-mcp/
