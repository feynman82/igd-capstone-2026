.env
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
node_modules/
web/.next/
inbox/

# corpus/batches/ IS committed. Synthetic batches travel through git so Lane E can hand a
# batch over by pushing it, rather than by a USB stick at the weekly session. Everything in
# it is generated from an invented canon and carries a SYNTHETIC DOCUMENT footer.
#
# corpus/holdout/ is NOT, and must never be. It is 40 *real* documents from team members,
# redacted under the consent protocol in docs/governance/. Committing one is not recoverable
# by deleting it — git keeps it. See NOTICE.md.
corpus/holdout/

# Celery beat's record of when it last ran each sweep. Local state, not a decision.
var/

# Graphify — only the graph and the report are committed, and only by the
# integration lead at the weekly session. See docs/GRAPHIFY.md.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_analysis.json
.graphify_python

# Word lock and crash artefacts
~$*
~WRL*.tmp

# Superseded drop folder. The canonical copies live in docs/artefacts/:
#   doc/PARROT_Revised_Proposal.docx -> docs/artefacts/PARROT_Revised_Proposal_v3.docx
#   doc/PARROT_Proposal_Deck.pptx    -> docs/artefacts/PARROT_Proposal_Deck.pptx
#   doc/PARROT_diagrams.zip          -> docs/artefacts/diagrams/*.png
/doc/
.playwright-mcp/
