# Parrot local configuration.
#
# Copy to the repository root as `.env` and edit only what you need:
#
#     cp infra/.env.example .env
#
# Every value below is also the built-in default, so a checkout with NO `.env` at all runs
# correctly against `infra/docker-compose.yml` on its default ports. Copy this file when you
# want to change a port, point at a second Ollama, or move the watched folder — not as a
# setup step you have to get right before anything works.
#
# Every URL must be loopback. `core/runtime/settings.py` rejects anything else, on purpose:
# v1 processes household documents on one computer and does not offer a network mode.

# ------------------------------------------------------------------------------------ port

# The port the local server listens on. 8000 is the default and is NOT always free —
# Docker Desktop binds 127.0.0.1:8000 on some machines, and a local reranker or another
# project may want it too. When you change it, change it in TWO places:
#
#   1. here, as PARROT_PORT
#   2. web/.env.local, as PARROT_API_URL=http://127.0.0.1:<the same port>
#
# The second one is how the screens find the engine. They are separate processes and
# neither can guess the other's port.
PARROT_PORT=8000

# The port the screens listen on. The engine starts them and tells them where it is,
# so this is the only place the interface's port is written down.
PARROT_WEB_PORT=3000

# --------------------------------------------------------------------------------- services

# Must match infra/docker-compose.yml. Change PARROT_DB_PORT there and here together.
DATABASE_URL=postgresql://parrot:parrot@127.0.0.1:5432/parrot
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------------- ollama

# Ollama runs on the host, not in Docker. One endpoint serves all three models by default.
OLLAMA_GEN_URL=http://127.0.0.1:11434

# A second endpoint for embedding and reranking, if you are splitting across two GPUs.
# Defaults to OLLAMA_GEN_URL when unset, which is what a single-card machine wants.
# OLLAMA_AUX_URL=http://127.0.0.1:11435

# ---------------------------------------------------------------------------------- models
#
# All three must be pulled before Parrot can read a document or answer a question:
#
#     ollama pull hf.co/mradermacher/Qwen-SEA-LION-v4-4B-VL-GGUF:Q4_K_M
#     ollama pull embeddinggemma:300m
#     ollama pull hf.co/gpustack/bge-reranker-v2-m3-GGUF:latest

# Generation and the quarantine image pass. Vision-language, so it can read a photographed page.
PARROT_GEN_MODEL=hf.co/mradermacher/Qwen-SEA-LION-v4-4B-VL-GGUF:Q4_K_M

# Embedding. The 768-dimension vector column in `chunks` is sized for this model — changing it
# is a migration, which is its own reviewed pull request.
PARROT_EMBED_MODEL=embeddinggemma:300m

# Cross-encoder reranker. A Hugging Face model id: it runs in-process, not through Ollama,
# because Ollama cannot serve a cross-encoder (docs/adr/0018). Fetched once into the HF cache.
PARROT_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Context window in tokens, between 1024 and 262144. Lower it on a smaller card.
PARROT_CONTEXT_TOKENS=16384

# ---------------------------------------------------------------------------------- capture

# The watched folder. Relative paths resolve against the repository root. v1 keeps this folder
# as the document store — nothing is copied into the database — so a document whose file is
# deleted from here can no longer be re-read.
WATCH_FOLDER=./inbox
