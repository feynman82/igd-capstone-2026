DATABASE_URL=postgresql://parrot:parrot@localhost:5432/parrot
REDIS_URL=redis://localhost:6379/0

# Two Ollama endpoints. At 4B the whole stack fits on one 8 GB card, so a single
# endpoint is fine on a laptop; the split exists for the 18 GB workstation and for
# benchmarking the 27B variants without evicting the small models.
OLLAMA_GEN_URL=http://127.0.0.1:11434
OLLAMA_AUX_URL=http://127.0.0.1:11435
PARROT_GEN_MODEL=hf.co/mradermacher/Qwen-SEA-LION-v4-4B-VL-GGUF:Q4_K_M
# AI Singapore does not publish an official GGUF for the Qwen-base 4B-VL (their own
# GGUF release under that name uses the Gemma base instead). mradermacher's quantisation
# of the Qwen-base model is what AGENTS.md's stack description actually points at.
PARROT_EMBED_MODEL=embeddinggemma:300m
PARROT_RERANK_MODEL=bge-reranker-v2-m3
PARROT_CONTEXT_TOKENS=16384
# The model offers 256K. 16K is the demo cap: the KV cache grows linearly and
# retrieval has already narrowed the evidence to six reranked passages.

# The quarantine second pass sends the page image to the same vision-language model.
PARROT_VISION_RETRY=1

WATCH_FOLDER=./inbox
TELEGRAM_BOT_TOKEN=
PARROT_PASSPHRASE_HASH=

# Never commit a real .env. Secrets live in the OS keychain.
